
MPI_RUN?=mpirun
MPI_CC?=mpicc
BUILD_DIR?=build

SRC=$(wildcard benchmarks/*.c) $(filter-out get_status.c parrived.c interval_tree_test.c custom_psend_old.c custom_psend_new.c custom_psend_dummy.c win.c partitioned_get_status.c, $(wildcard src/*.c))
SRC_NOPSEND=$(filter-out $(wildcard benchmarks/bench_psen*.c), $(SRC)) benchmarks/bench_psend_custom.c

CFLAGS=-fopenmp -lm -lpthread -I. -Wall -O1 -DNDEBUG

# benchmark compilation units
MAIN_SRC=src/bench.c
MAIN_OBJ=$(patsubst src/%.c,$(BUILD_DIR)/%.o, $(MAIN_SRC))
FRAMEWORK_SRC=$(filter-out src/bench.c src/custom_psend_dummy.c, $(wildcard src/*.c)) 
FRAMEWORK_OBJ=$(patsubst src/%.c,$(BUILD_DIR)/%.o, $(FRAMEWORK_SRC) src/custom_psend_dummy.c)
BENCHMARKS_SRC=$(wildcard src/benchmarks/*.c)
BENCHMARKS_OBJ=$(patsubst src/%.c,$(BUILD_DIR)/%.o, $(BENCHMARKS_SRC))

$(BUILD_DIR)/%.o: src/%.c
	mkdir -p $(@D) &&\
	$(MPI_CC) $^ -O2 -c -Isrc -fopenmp -o $@

$(BUILD_DIR)/bench: $(MAIN_SRC) $(BENCHMARKS_OBJ) $(FRAMEWORK_OBJ)
	$(MPI_CC) $(filter %c %.o,$^) $(CFLAGS) -o $@

$(BUILD_DIR)/trace: $(MAIN_SRC) $(BENCHMARKS_OBJ) $(FRAMEWORK_OBJ)
	scorep-mpicc $(filter %c %.o,$^) $(CFLAGS) -o $@


run: $(BUILD_DIR)/bench
	qsub $(BENCH_SCRIPT)

.phony: build
build: $(BUILD_DIR)/bench


