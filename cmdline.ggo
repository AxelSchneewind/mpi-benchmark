package "mpi-benchmark"
version "0.42"
purpose "measure effective bandwidth for different transfer modes in a multithreaded setting"
usage "<usage>"
description "<description>"
versiontext ""

args "--default-optional"

option "mode" m "mode of transfer" string default="Send"
option "num-values" n "number of values to communicate in tests" int default="4096"
option "partition-size" q "number of values per partition" int default="100"
option "partition-size-max" Q "maximum number of values per partition (if specified, paritition counts between min and max will be used)" int default="0"
option "allow-1-to-n" - "whether to test cases where receive side has more partitions than sender" int default="0"
option "allow-n-to-1" - "whether to test cases where send    side has more partitions than receiver" int default="0"
option "iterations" i "number of iterations" int default="100"
option "send-pattern" p "order in which elements will be marked ready" string default="Linear"
option "num-threads" j "number of threads" int default="1"
option "computations-per-element" c "number of iterations of a simple computation to run for each data element" int default="1000"
